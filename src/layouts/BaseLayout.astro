---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CursorCompanion from '../islands/CursorCompanion.tsx';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: string;
}

const {
  title = 'Uzziel Malolos — Products, systems, and games',
  description = 'Portfolio of Emmanuel Uzziel A. Malolos: full-stack products, automation, websites, and indie games.',
  image = '/og-default.svg',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://uzzy.lol');
const ogImage = new URL(image, Astro.site ?? 'https://uzzy.lol').toString();
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E9W7BQN668"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E9W7BQN668');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1410" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,ital,wght@9..144,0..1,300..900&family=Inter+Tight:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <ViewTransitions />

    <script is:inline>
      (() => {
        try {
          document.documentElement.classList.remove('no-js');
          document.documentElement.classList.add('js');
          const saved = localStorage.getItem('uzziel-theme');
          const dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <style is:global>
      :where(a, button, [role="button"], input, select, textarea, summary, [tabindex="0"]):focus-visible {
        outline: 2px solid var(--accent, #6b3410);
        outline-offset: 2px;
        border-radius: 2px;
      }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 60;
        padding: 0.5rem 1rem;
        background: #1a1410;
        color: #f4ecd8;
        border-radius: 0.375rem;
        font-weight: 500;
        transition: top 180ms ease;
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>
  </head>
  <body class="bg-cream text-ink dark:bg-ink dark:text-cream antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" transition:animate="slide">
      <slot />
    </main>
    <Footer />
    <div class="grain-overlay" aria-hidden="true"></div>
    <CursorCompanion client:load />

    <script>
      import Lenis from 'lenis';
      import { initRevealOnScroll } from '../lib/revealOnScroll.ts';
      import { initMagnetic } from '../lib/magnetic.ts';

      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      let lenis: Lenis | undefined;
      const syncMotion = () => {
        lenis?.destroy();
        lenis = undefined;
        if (!motionPreference.matches) {
          lenis = new Lenis({ duration: 1.05, smoothWheel: true, autoRaf: true, anchors: true });
        }
      };
      syncMotion();
      motionPreference.addEventListener('change', syncMotion);
      document.addEventListener('astro:before-swap', () => {
        lenis?.destroy();
        lenis = undefined;
      });

      // Header chrome + brass scroll-progress hairline, updated via rAF throttle.
      let scrollRaf = 0;
      const syncScrollChrome = () => {
        scrollRaf = 0;
        const y = window.scrollY;
        const nav = document.getElementById('site-nav');
        if (nav) nav.dataset.scrolled = y > 12 ? 'true' : 'false';
        const bar = document.getElementById('site-scroll-bar');
        if (bar && !motionPreference.matches) {
          const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
          const ratio = Math.min(Math.max(y / max, 0), 1);
          bar.style.transform = `scaleX(${ratio})`;
        }
      };
      const queueScrollSync = () => {
        if (!scrollRaf) scrollRaf = window.requestAnimationFrame(syncScrollChrome);
      };
      window.addEventListener('scroll', queueScrollSync, { passive: true });
      window.addEventListener('resize', queueScrollSync, { passive: true });

      // Delegated pointer spotlight & subtle 3D cover micro-tilt for work and
      // Google Play cards (CSS reads --mx/--my/--rx/--ry; zero React overhead).
      const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
      let activeCover: HTMLElement | null = null;
      const resetCoverTilt = (cover: HTMLElement | null) => {
        if (!cover) return;
        cover.style.setProperty('--rx', '0deg');
        cover.style.setProperty('--ry', '0deg');
      };

      document.addEventListener('pointermove', (e) => {
        const target = e.target;
        if (!(target instanceof Element) || motionPreference.matches || !fineHover.matches) return;

        const workCard = target.closest<HTMLElement>('[data-work-card]');
        const cover = workCard?.querySelector<HTMLElement>('.work-cover') ?? null;
        if (activeCover && activeCover !== cover) {
          resetCoverTilt(activeCover);
          activeCover = null;
        }
        if (cover) {
          activeCover = cover;
          const r = cover.getBoundingClientRect();
          const lx = e.clientX - r.left;
          const ly = e.clientY - r.top;
          const px = Math.min(Math.max(lx / Math.max(r.width, 1), 0), 1);
          const py = Math.min(Math.max(ly / Math.max(r.height, 1), 0), 1);
          const rx = ((0.5 - py) * 6.5).toFixed(2);
          const ry = ((px - 0.5) * 6.5).toFixed(2);
          cover.style.setProperty('--mx', `${lx}px`);
          cover.style.setProperty('--my', `${ly}px`);
          cover.style.setProperty('--rx', `${rx}deg`);
          cover.style.setProperty('--ry', `${ry}deg`);
        }

        const playCard = target.closest<HTMLElement>('.play-card');
        if (playCard) {
          const r = playCard.getBoundingClientRect();
          playCard.style.setProperty('--mx', `${e.clientX - r.left}px`);
          playCard.style.setProperty('--my', `${e.clientY - r.top}px`);
        }
      });

      document.addEventListener('pointerleave', () => {
        resetCoverTilt(activeCover);
        activeCover = null;
      });

      // Fire on initial load and re-run after every Astro view transition.
      const initPage = () => {
        if (!lenis) syncMotion();
        else lenis.resize();
        resetCoverTilt(activeCover);
        activeCover = null;
        initRevealOnScroll();
        initMagnetic();
        syncScrollChrome();
      };
      initPage();
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
