---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineCard from '../components/TimelineCard.astro';

const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Emmanuel Uzziel A. Malolos',
  alternateName: 'Uzziel Malolos',
  url: 'https://uzzy.lol',
  jobTitle: 'Full-stack creator and product builder',
  description:
    'Full-stack creator and Levi Co. co-founder from Bay, Laguna. Builds indie games, AI tools, mobile apps, and websites.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bay',
    addressRegion: 'Laguna',
    addressCountry: 'PH',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of the Philippines Los Baños',
  },
  knowsAbout: [
    'Product Design',
    'Full-Stack Development',
    'Web Development',
    'Game Development',
    'AI Integration',
    'Automation',
  ],
});

const intro =
  "I'm a fourth-year student at UPLB, a full-stack creator, and a co-founder of Levi Co.. I build indie games, AI tools, mobile apps, and websites for small teams and my church. I work mostly from Bay, Laguna with a Xiaomi Pad 6 and a folding keyboard; the heavy builds run on a small Windows tower at home.";

const timeline = [
  { year: '2018', text: "Started volunteering as web dev for The Lord's Worship Center." },
  { year: '2023', text: "Joined Oka's Farm as farm accountant." },
  { year: '2024', text: "Concluded Oka's Farm role; expanded into independent product work." },
  { year: '2025', text: 'TIRADOR development begins; AI micro-agency conceived.' },
  {
    year: '2026',
    text: 'Co-founded Levi Co.; published Fitness Pace and Needs vs. Wants on Google Play, shipped The Last Moon, Comtus AI desktop, and Cozy Party v1.2, and began building Spinroot and Rimegard.',
  },
];

const building = [
  {
    name: 'Spinroot',
    slug: 'spinroot',
    text: 'Cozy Hi-Bit pixel farm above a dark underground delve in Godot 4.6, linked by a 3x3 Wishing Reel shrine and 148 passing headless tests.',
  },
  {
    name: 'Rimegard',
    slug: 'rimegard',
    text: 'PC-first 3D frozen-industrial RPG in Godot 4.6 and Blender approaching Steam release, built around Titan Boilers and Body Heat survival.',
  },
  {
    name: 'Cozy Party: Steam Edition',
    slug: 'cozy-party-steam',
    text: 'Unity 6 URP active-ragdoll 3D party brawler with 14-shell volumetric plush fur and six playable scenes alongside the live browser edition.',
  },
  {
    name: 'Eco-Man',
    slug: 'eco-man',
    text: 'Native Kotlin and Compose Android business record book (v1.0.14) for reviewed receipts, statements, private originals, and multilingual books.',
  },
  {
    name: 'Comtus AI',
    slug: 'comtus-ai',
    text: 'Local-first study workspace live on web, Windows, and macOS (v0.3.9) turning PDFs and notes into cited answers, flashcards, and exam plans.',
  },
  {
    name: 'FoodToGo',
    slug: 'foodtogo',
    text: 'Philippine neighborhood food-delivery monorepo covering consumer ordering, merchant controls, rider COD dispatch, and operations tooling.',
  },
];

const photos = [
  { src: '/photos/uzziel-casual.webp', caption: 'Studio portrait, October 2026.' },
  { src: '/photos/levi-co-team.webp', caption: 'With Levi Co. co-founders Aaron Panergayo and Philip Lizardo.' },
];
---

<BaseLayout
  title="About — Uzziel Malolos"
  description="Full-stack creator and Levi Co. co-founder from Bay, Laguna."
  jsonLd={personJsonLd}
>
  <!-- Intro -->
  <section class="container pb-16 pt-12 md:pt-16">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">About · The person</p>
      <p class="meta-mono hidden sm:block">Bay · Laguna · 14.18°N, 121.28°E</p>
    </div>

    <div class="grid gap-12 pt-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <h1 data-reveal style="font-size: clamp(2.8rem, 7vw, 5.75rem); line-height: 0.98;">
          One desk in<br />
          <em class="text-accent">Bay, Laguna.</em>
        </h1>
        <p data-reveal data-reveal-delay="100" class="mt-8 max-w-2xl text-lg leading-relaxed text-stone">
          {intro}
        </p>
      </div>
      <figure class="group relative mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none" data-reveal="zoom" data-reveal-delay="160">
        <div class="absolute -bottom-3 -right-3 h-full w-full border border-gold/50 transition-transform duration-500 ease-out motion-safe:group-hover:translate-x-1.5 motion-safe:group-hover:translate-y-1.5" aria-hidden="true"></div>
        <div class="relative overflow-hidden border border-line-strong transition-colors duration-300 group-hover:border-gold/70">
          <img
            src="/photos/uzziel-studio.webp"
            alt="Emmanuel Uzziel Malolos studio portrait"
            width="800"
            height="1000"
            loading="eager"
            decoding="async"
            class="aspect-[4/5] w-full object-cover object-top transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.03]"
          />
          <div class="dither-up dither-page absolute inset-x-0 bottom-0" aria-hidden="true"></div>
        </div>
        <figcaption class="meta-mono mt-4 flex items-center justify-between gap-4">
          <span>Emmanuel Uzziel A. Malolos</span>
          <span>Studio portrait · 2026</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 01 Roots -->
  <section class="container py-16 md:py-20">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">01 · Roots</p>
      <p class="meta-mono hidden sm:block">Brgy. Calo, Bay, Laguna</p>
    </div>
    <div class="grid gap-8 pt-10 lg:grid-cols-12">
      <h2 class="text-3xl lg:col-span-4" data-reveal>Where I'm from</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:col-span-8">
        <p data-reveal data-reveal-delay="60" class="leading-relaxed">
          I grew up in Brgy. Calo, Bay, Laguna. Working around small local businesses, church volunteers, commuters, and family-run operations shaped the products I build: practical tools that work on ordinary devices and make sense without a manual.
        </p>
        <p data-reveal data-reveal-delay="120" class="leading-relaxed">
          I am Filipino, a fourth-year undergrad in the College of Economics and Management at UPLB, taking BS Agricultural and Applied Economics with a Natural Resource Economics major. I commute when I can and stay on campus when I cannot.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 On the bench -->
  <section class="container py-16 md:py-20">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">02 · On the bench</p>
      <p class="meta-mono hidden sm:block">Six builds in motion</p>
    </div>
    <div class="grid gap-8 pt-10 lg:grid-cols-12">
      <h2 class="text-3xl lg:col-span-4" data-reveal>What I'm building right now</h2>
      <div class="lg:col-span-8">
        {building.map((item, i) => (
          <a
            href={`/work/${item.slug}`}
            data-cursor="hover"
            data-cursor-label="View case"
            class="ledger-row group grid grid-cols-[2.5rem_1fr] items-baseline gap-4 border-b border-line py-5 first:border-t md:grid-cols-[2.5rem_14rem_1fr] md:gap-6"
            data-reveal
            data-reveal-delay={Math.min(i * 70, 350)}
          >
            <span class="font-mono text-[11px] text-gold" aria-hidden="true">0{i + 1}</span>
            <h3 class="text-xl leading-tight transition-colors group-hover:text-accent">{item.name}</h3>
            <p class="col-span-2 mt-1 text-sm leading-relaxed text-stone md:col-span-1 md:mt-0">{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 The route -->
  <section class="container py-16 md:py-20">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">03 · The route</p>
      <p class="meta-mono hidden sm:block">2018 to present</p>
    </div>
    <div class="grid gap-8 pt-10 lg:grid-cols-12">
      <h2 class="text-3xl lg:col-span-4" data-reveal>Where I've been</h2>
      <div class="lg:col-span-8">
        <TimelineCard entries={timeline} />
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          <p data-reveal class="text-sm leading-relaxed text-stone">
            I have been the volunteer web developer for The Lord's Worship Center in Bay since 2018. The role started small (HTML and a contact form) and has grown into a small design system rewrite this year.
          </p>
          <p data-reveal data-reveal-delay="80" class="text-sm leading-relaxed text-stone">
            From March 2023 to May 2024 I kept the books for Oka's Farm: fourteen months of payables, payroll, and monthly closings, the work that taught me what the textbooks leave out.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 The desk -->
  <section class="container py-16 md:py-20">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">04 · The desk</p>
      <p class="meta-mono hidden sm:block">Pad 6 on the road · tower at home</p>
    </div>
    <div class="grid gap-8 pt-10 lg:grid-cols-12">
      <h2 class="text-3xl lg:col-span-4" data-reveal>How I work</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:col-span-8">
        <p data-reveal data-reveal-delay="60" class="leading-relaxed">
          Most writing and light development happens on a Xiaomi Pad 6 with a folding keyboard across coffee shops, libraries, jeepneys, and the kitchen table. The heavier builds run on a small Windows tower at home for Godot and Unity exports, Blender renders, and video mixes.
        </p>
        <p data-reveal data-reveal-delay="120" class="leading-relaxed">
          AI coding tools collaborate across project notes, code, and prose. I am faith-rooted (TLWC is family) but I do not push it into client work. If a deliverable is for a business, the work answers to the business.
        </p>
      </div>
    </div>
  </section>

  <!-- 05 Field notes -->
  <section class="container py-16 md:py-24">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">05 · Field notes</p>
      <p class="meta-mono hidden sm:block">Studio and team · 2026</p>
    </div>
    <h2 class="sr-only">A few photos</h2>
    <div class="grid gap-6 pt-10 md:grid-cols-2 md:gap-8">
      {photos.map((p, i) => (
        <figure class="group" data-reveal="zoom" data-reveal-delay={i * 100}>
          <div class="relative overflow-hidden border border-line-strong transition-colors duration-300 group-hover:border-gold/70">
            <img
              src={p.src}
              alt={p.caption}
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover object-top transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.03]"
            />
            <div class="dither-up dither-page absolute inset-x-0 bottom-0" aria-hidden="true"></div>
          </div>
          <figcaption class="meta-mono mt-3 flex items-baseline gap-3">
            <span class="inline-block h-[5px] w-[5px] flex-none translate-y-[-1px] bg-gold" aria-hidden="true"></span>
            {p.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
